# Local-only instructions (machine specs, local model tags)
CLAUDE.local.md

# Real screenshots used for the model spike: the maintainer's own captures,
# containing personal data including a third party's email address. They never
# enter version control. Only the generated synthetic fixture set is committed.
samples/*
!samples/synthetic/
!samples/README.md

.DS_Store

# Spike results are machine-specific; the Mac figures live in docs/BENCHMARKS.md.
# Keep the directory so the script has somewhere to write.
spike/results/*
!spike/results/.gitkeep
