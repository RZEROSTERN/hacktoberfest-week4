# Development only. The packaged app sets all of this itself from the desktop shell,
# and none of these values are read from a user's environment at run time.

# Where the api listens. The web app's default points here.
SLOTHSHOT_HOST=127.0.0.1
SLOTHSHOT_PORT=8765

# The Ollama to talk to. In development this is the one installed natively on the machine,
# not the bundled copy and not Docker.
SLOTHSHOT_OLLAMA_URL=http://127.0.0.1:11434

# Local state: the SQLite index and journal, and model metadata.
SLOTHSHOT_DATA_DIR=.dev/data
SLOTHSHOT_MODELS_DIR=.dev/models

# Seeds the vision model into the settings table on first start when nothing is stored yet.
# The tag is never hard-coded in the code; the wizard writes it in the packaged app.
SLOTHSHOT_VISION_MODEL=gemma4:e2b

# Longest side in pixels an image is downscaled to before inference. The spike tunes this.
SLOTHSHOT_MAX_IMAGE_PX=1024

# Origins allowed to call the api. The desktop shell passes its own app:// origin.
SLOTHSHOT_CORS_ORIGINS=["http://localhost:3000"]

# Where the web app looks for the api when run in a plain browser.
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8765
